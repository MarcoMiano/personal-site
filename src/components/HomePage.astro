---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePanel from './ProfilePanel.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';
import { getPath, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const showUnpublishedProjects = import.meta.env.DEV;
const projectEntries = (await getCollection('projects')).filter(
  (entry) =>
    entry.data.locale === locale &&
    (showUnpublishedProjects || (!entry.data.draft && !entry.data.noindex)),
);
const landingProjects = projectEntries
  .filter((entry) => entry.data.featured)
  .sort((left, right) =>
    left.data.translationKey.localeCompare(right.data.translationKey, 'en'),
  );
const latestUpdates = (await getCollection('updates'))
  .filter(
    (entry) =>
      entry.data.locale === locale && !entry.data.draft && !entry.data.noindex,
  )
  .sort(
    (left, right) =>
      right.data.publishedAt.localeCompare(left.data.publishedAt) ||
      left.data.translationKey.localeCompare(right.data.translationKey, 'en'),
  )
  .slice(0, 5);
const dateFormatter = new Intl.DateTimeFormat(
  locale === 'it' ? 'it-IT' : 'en-GB',
  {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  },
);

const content = {
  it: {
    updates: 'Ultimi aggiornamenti',
    systemTitle: 'Progetti selezionati.',
    systemDescription:
      'Software e integrazione AV raccontati attraverso problemi, responsabilità e risultati concreti.',
    categories: {
      software: 'SOFTWARE',
      'av-automation': 'AV/AUTO',
      infrastructure: 'INFRA',
    },
    statuses: {
      concept: 'CONCEPT',
      active: 'ACTIVE',
      complete: 'COMPLETE',
      maintained: 'MAINTAINED',
      archived: 'ARCHIVED',
    },
    inspect: 'Apri il case study',
    contact: 'Contatti',
    projects: 'Esplora i progetti',
  },
  en: {
    updates: 'Latest updates',
    systemTitle: 'Selected projects.',
    systemDescription:
      'Software and AV integration presented through concrete problems, responsibilities, and outcomes.',
    categories: {
      software: 'SOFTWARE',
      'av-automation': 'AV/AUTO',
      infrastructure: 'INFRA',
    },
    statuses: {
      concept: 'CONCEPT',
      active: 'ACTIVE',
      complete: 'COMPLETE',
      maintained: 'MAINTAINED',
      archived: 'ARCHIVED',
    },
    inspect: 'Open case study',
    contact: 'Contact',
    projects: 'Explore projects',
  },
} as const;

const copy = content[locale];
---

<BaseLayout {locale} page="home">
  <ProfilePanel slot="hero-aside" {locale} priority />

  <div
    class="hero-actions"
    aria-label={locale === 'it' ? 'Azioni principali' : 'Primary actions'}
  >
    <a
      class="action-link action-link--primary"
      href={getPath(locale, 'projects')}
    >
      {copy.projects}
    </a>
    <a class="action-link" href={getPath(locale, 'contact')}>
      {copy.contact}
    </a>
  </div>

  {latestUpdates.length > 0 && (
    <section
      class="work-section updates-section"
      aria-labelledby="latest-updates"
    >
      <SectionHeading index="01" id="latest-updates" title={copy.updates} />
      <ul class="updates-list">
        {latestUpdates.map((entry) => (
          <li>
            <time datetime={entry.data.publishedAt}>
              {dateFormatter.format(
                new Date(`${entry.data.publishedAt}T00:00:00Z`),
              )}
            </time>
            <div>
              <h3>
                <a href={entry.data.href}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="work-section" aria-labelledby="operating-benches">
    <SectionHeading
      index={latestUpdates.length > 0 ? '02' : '01'}
      id="operating-benches"
      title={copy.systemTitle as string}
      description={copy.systemDescription as string}
    />
    <div class="project-grid">
      {landingProjects.map((project, index) => (
        <ProjectCard
          index={String(index + 1).padStart(2, '0')}
          category={copy.categories[project.data.category]}
          title={project.data.title}
          summary={project.data.summary}
          status={copy.statuses[project.data.status]}
          href={`${getPath(locale, 'projects')}#project-${project.data.translationKey}`}
          linkLabel={copy.inspect}
          featured={index === 0}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .updates-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .updates-list li {
    display: grid;
    grid-template-columns: minmax(8rem, 0.2fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .updates-list time {
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  .updates-list h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .updates-list p {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
  }

  @media (max-width: 40rem) {
    .updates-list li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
