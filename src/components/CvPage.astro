---
import { getCollection } from 'astro:content';
import Page from './Page.astro';
import ProfilePanel from './ProfilePanel.astro';
import SectionHeading from './SectionHeading.astro';
import { getCurrentTenure } from '../lib/cv';
import { getPath, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entries = await getCollection('cv');
const cv = entries.find((entry) => entry.data.locale === locale)?.data;

if (!cv) {
  throw new Error(`Missing ${locale} CV content`);
}

const labels = {
  it: {
    profile: 'Profilo',
    experience: 'Esperienza',
    education: 'Formazione',
    certifications: 'Certificazioni',
    skills: 'Competenze',
    languages: 'Lingue',
    review: 'Bozza bilingue in revisione',
    relatedProject: 'Vedi il case study collegato',
  },
  en: {
    profile: 'Profile',
    experience: 'Experience',
    education: 'Education',
    certifications: 'Certifications',
    skills: 'Skills',
    languages: 'Languages',
    review: 'Bilingual draft under review',
    relatedProject: 'View the related case study',
  },
} as const;

const copy = labels[locale];
---

<Page {locale} page="cv">
  <div class="cv-overview">
    <ProfilePanel {locale} />
    <section class="cv-summary" aria-labelledby="cv-profile-heading">
      <div class="module-label" aria-hidden="true">
        <span>struct cv_profile</span><span>status = "draft"</span>
      </div>
      <p class="eyebrow">{cv.location}</p>
      <h2 id="cv-profile-heading">{cv.headline}</h2>
      <p>{cv.summary}</p>
      {
        cv.draft && (
          <p class="provisional">
            <span aria-hidden="true">//</span>
            {copy.review}
          </p>
        )
      }
    </section>
  </div>

  <section class="cv-section" aria-labelledby="cv-experience-heading">
    <SectionHeading
      index="01"
      id="cv-experience-heading"
      title={copy.experience}
    />
    <div class="cv-timeline">
      {
        cv.experience.map((group) => (
          <section class="cv-employer" aria-labelledby={`employer-${group.id}`}>
            <header class="cv-employer__header">
              <h3 class="cv-employer__name" id={`employer-${group.id}`}>
                {group.employer}
              </h3>
              <p class="cv-employer__tenure">
                <span>{group.period}</span>
                <span>
                  {group.startMonth
                    ? getCurrentTenure(group.startMonth, locale)
                    : group.duration}
                </span>
              </p>
            </header>
            <ol class="cv-employer__roles">
              {group.roles.map((item) => (
                <li
                  class:list={[
                    'cv-role',
                    { 'cv-role--project': item.relatedProject },
                  ]}
                >
                  <article>
                    <div class="cv-role__period">{item.period}</div>
                    <div class="cv-role__body">
                      <h4>{item.title}</h4>
                      {item.assignment && (
                        <p class="cv-role__assignment">{item.assignment}</p>
                      )}
                      {item.relatedProject && (
                        <a
                          class="cv-role__project-link"
                          href={`${getPath(locale, 'projects')}#project-${item.relatedProject}`}
                        >
                          {copy.relatedProject}
                          <span aria-hidden="true"> →</span>
                        </a>
                      )}
                      <p>{item.summary}</p>
                      {item.highlights.length > 0 && (
                        <ul>
                          {item.highlights.map((highlight) => (
                            <li>{highlight}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>

  <div class="cv-columns">
    <section class="cv-section" aria-labelledby="cv-education-heading">
      <SectionHeading
        index="02"
        id="cv-education-heading"
        title={copy.education}
      />
      {
        cv.education.map((item) => (
          <article class="cv-compact-entry">
            <p>{item.period}</p>
            <h3>{item.qualification}</h3>
            <p>{item.institution}</p>
          </article>
        ))
      }
    </section>

    <section class="cv-section" aria-labelledby="cv-certifications-heading">
      <SectionHeading
        index="03"
        id="cv-certifications-heading"
        title={copy.certifications}
      />
      <ul class="cv-plain-list">
        {cv.certifications.map((item) => <li>{item.name}</li>)}
      </ul>
    </section>
  </div>

  <div class="cv-columns">
    <section class="cv-section" aria-labelledby="cv-skills-heading">
      <SectionHeading index="04" id="cv-skills-heading" title={copy.skills} />
      <div class="cv-skill-groups">
        {
          cv.skills.map((group) => (
            <div>
              <h3>{group.label}</h3>
              <p>{group.items.join(' · ')}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-languages-heading">
      <SectionHeading
        index="05"
        id="cv-languages-heading"
        title={copy.languages}
      />
      <ul class="cv-plain-list">
        {
          cv.languages.map((item) => (
            <li>
              <strong>{item.name}</strong> — {item.proficiency}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Page>
