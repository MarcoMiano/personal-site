---
import ExternalBrandIcon from './ExternalBrandIcon.astro';
import { resolveBuildRevision } from '../lib/build';
import { getPath, pages, ui, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const buildRevision = resolveBuildRevision(
  import.meta.env.SITE_BUILD_REVISION as string | undefined,
);
const buildRevisionLabel = `${ui[locale].footerBuildRevision}: ${buildRevision.value}`;
---

<footer
  class="site-footer"
  data-site-footer
  data-build-revision={buildRevision.value}
>
  <p><span aria-hidden="true">status =</span> {ui[locale].footerStatus}</p>
  <p class="footer-revision">
    <span>build.sha = &quot;</span>
    {
      buildRevision.url ? (
        <a
          class="external-brand-link footer-revision__link"
          href={buildRevision.url}
          aria-label={buildRevisionLabel}
          title={buildRevisionLabel}
          data-external-brand-link
        >
          <span aria-hidden="true">{buildRevision.short}</span>
          <span aria-hidden="true">&quot;</span>
          <ExternalBrandIcon url={buildRevision.url} />
        </a>
      ) : (
        <>
          <span>LOCAL</span>
          <span>&quot;</span>
        </>
      )
    }
  </p>
  <p class="footer-credit">
    <span>built by </span>
    <strong>MarcoMiano</strong>
    <span aria-hidden="true">//</span>
    <span>codex-assisted</span>
  </p>
  <nav class="footer-nav" aria-label={ui[locale].footerNavigation}>
    <ul>
      <li>
        <a href={getPath(locale, 'credits')}>{pages.credits.label[locale]}</a>
      </li>
      <li>
        <a href={getPath(locale, 'privacy')}>{pages.privacy.label[locale]}</a>
      </li>
    </ul>
  </nav>
</footer>
