---
interface Props {
  url: string;
}

const { url } = Astro.props;
const hostname = new URL(url).hostname.replace(/^www\./, '');
const brand =
  hostname === 'github.com'
    ? 'github'
    : hostname === 'linkedin.com'
      ? 'linkedin'
      : hostname === 'bsky.app'
        ? 'bluesky'
        : 'external';
const usesPixelLibrary = brand !== 'external';
const iconSource = usesPixelLibrary ? 'hackernoon-pixel-icon-library' : 'local';
---

<svg
  class="external-brand-icon"
  data-brand={brand}
  data-icon-source={iconSource}
  data-icon-license={usesPixelLibrary ? 'CC-BY-4.0' : undefined}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  shape-rendering="crispEdges"
>
  {
    brand === 'github' ? (
      <polygon
        points="23 9 23 15 22 15 22 17 21 17 21 19 20 19 20 20 19 20 19 21 18 21 18 22 16 22 16 23 15 23 15 18 14 18 14 17 15 17 15 16 17 16 17 15 18 15 18 14 19 14 19 9 18 9 18 6 16 6 16 7 15 7 15 8 14 8 14 7 10 7 10 8 9 8 9 7 8 7 8 6 6 6 6 9 5 9 5 14 6 14 6 15 7 15 7 16 9 16 9 18 7 18 7 17 6 17 6 16 4 16 4 17 5 17 5 19 6 19 6 20 9 20 9 23 8 23 8 22 6 22 6 21 5 21 5 20 4 20 4 19 3 19 3 17 2 17 2 15 1 15 1 9 2 9 2 7 3 7 3 5 4 5 4 4 5 4 5 3 7 3 7 2 9 2 9 1 15 1 15 2 17 2 17 3 19 3 19 4 20 4 20 5 21 5 21 7 22 7 22 9 23 9"
        fill="currentColor"
      />
    ) : brand === 'linkedin' ? (
      <path
        d="m22 2V1H2v1H1v20h1v1h20v-1h1V2h-1Zm-9 10v8h-3V9h3v1h1V9h4v1h1v10h-3v-8h-3ZM4 8V5h3v3H4Zm3 1v11H4V9h3Z"
        fill="currentColor"
      />
    ) : brand === 'bluesky' ? (
      <path
        d="M23 3v8h-1v2h-2v1h-2v1h2v1h1v3h-1v1h-1v1h-2v1h-2v-1h-1v-1h-1v-2h-2v2h-1v1H9v1H7v-1H5v-1H4v-1H3v-3h1v-1h2v-1H4v-1H2v-2H1V3h1V2h2v1h2v1h1v1h1v1h1v1h1v2h1v1h2V9h1V7h1V6h1V5h1V4h1V3h2V2h2v1h1Z"
        fill="currentColor"
      />
    ) : (
      <path
        d="M3 3h10v3H6v12h12v-7h3v10H3V3Zm12 0h6v6h-3V7l-7 7-2-2 7-7h-1V3Z"
        fill="currentColor"
      />
    )
  }
</svg>
